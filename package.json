    "game-qa",
    "playtest",
    "regression",
    "gamepad",
    "xinput",
    "vigem",
    "presentmon",
    "frame-time",
    "windows",
    "replay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-durango/qaping-rig.git"
  },
  "type": "commonjs",
  "bin": {
    "qaping-rig": "bin/rig.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "Start Rig.cmd",
    "scripts/start-desktop.ps1",
    "lib/desktop.js",
    "lib/video-tool.js",
    "shims/desktop.cs",
    "bin/rig.js",
    "lib/cli.js",
    "shims/padd.py",
    "shims/xinput-tap.ps1",
    "shims/keyboard-mouse.ps1",
    "shims/keyboard-mouse.cs",
    "lib/kbmscript.js",
    "lib/keyboard-mouse.js",
    "lib/build-fetch.js",
    "lib/capture.js",
    "lib/game-proc.js",
    "lib/overlay.js",
    "lib/pad.js",
    "lib/padscript.js",
    "lib/receipt.js",
    "lib/report.js",
    "lib/scheduler.js",
    "lib/telemetry-presentmon.js",
    "scripts/provision.ps1",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/alex-durango/qaping-rig/issues"
  },
  "scripts": {
    "test": "node --test test/rig.test.js"
  }
}
